# ==============================================================================
# Studio Marilia Camilo — Configurações de Ambiente (Backend / Django)
# Copie este arquivo para .env e preencha os valores: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Segurança e Ambiente Django
# ------------------------------------------------------------------------------
# Chave secreta de criptografia e sessões do Django (gere uma nova em produção)
SECRET_KEY=django-insecure-camilo-studio-production-key-secret-2026

# Modo de depuração (True para desenvolvimento local, False para homologação/produção)
DEBUG=True

# URL pública da aplicação frontend (utilizada nos links dos e-mails de acesso e recuperação)
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Configurações de Envio de E-mail (SMTP)
# ------------------------------------------------------------------------------
# Backend de e-mail do Django
# - Em produção/desenvolvimento com e-mail real: django.core.mail.backends.smtp.EmailBackend
# - Para testar no terminal sem envio real: django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Servidor SMTP (padrão Gmail: smtp.gmail.com)
EMAIL_HOST=smtp.gmail.com

# Porta do servidor SMTP (587 para TLS)
EMAIL_PORT=587

# Habilitar criptografia STARTTLS
EMAIL_USE_TLS=True

# Conta de e-mail remetente
EMAIL_HOST_USER=seu-email@gmail.com

# Senha de Aplicativo de 16 caracteres gerada no Google (Segurança > Verificação em duas etapas > Senhas de app)
# Nota: Não utilize a senha comum da sua conta Google, e sim a Senha de Aplicativo.
EMAIL_HOST_PASSWORD=sua-senha-de-app-aqui

# Nome e e-mail exibidos no cabeçalho "De:" das mensagens enviadas aos clientes e equipe
DEFAULT_FROM_EMAIL=Studio Marilia Camilo <seu-email@gmail.com>
