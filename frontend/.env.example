# ==============================================================================
# Studio Marilia Camilo — Configurações de Ambiente (Frontend / Next.js)
# Copie este arquivo para .env.local: cp .env.example .env.local
# ==============================================================================

# URL interna da API Django utilizada pelo Next.js no rewrite de proxy (/api/* -> DJANGO_API_URL/*)
DJANGO_API_URL=http://127.0.0.1:8000

# Endpoint base da API consumido pelo cliente web (padrão: /api para usar o rewrite do Next.js)
NEXT_PUBLIC_API_URL=/api
